<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>
		<!-- Entity Framework Core - ВСЕГДА 10.0.14 -->
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Analyzers" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />

		<!-- Npgsql -->
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageVersion Include="Npgsql" Version="10.0.3" />

		<!-- ASP.NET Core -->
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />

		<!-- Test SDK -->
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
		<PackageVersion Include="coverlet.collector" Version="6.0.4" />

		<!-- Testcontainers -->
		<PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
	</ItemGroup>
</Project>